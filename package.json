{
  "name": "dsh-relay-overview",
  "version": "0.9.0",
  "description": "DSH Web relay overview for Sub2API-compatible relay providers",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "sub2api",
    "relay",
    "overview",
    "balance"
  ],
  "license": "MIT",
  "author": "ww2186874-cyber",
  "packageManager": "pnpm@11.22.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ww2186874-cyber/dsh-relay-overview.git"
  },
  "homepage": "https://github.com/ww2186874-cyber/dsh-relay-overview#readme",
  "bugs": {
    "url": "https://github.com/ww2186874-cyber/dsh-relay-overview/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "bundle": "node scripts/build-client.js",
    "bundle:check": "node scripts/check-client.js",
    "check": "node --check lib/index.js && node --check src/client-module.js && node --check lib/client.js && node --check scripts/build-client.js && node --check scripts/check-client.js",
    "verify": "pnpm run bundle:check && pnpm run check && pnpm run test",
    "prepack": "pnpm run verify"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": "0.1.2-alpha.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
